#!/bin/sh
# Read one secret and write it to standard output, with no newline after it
# and nothing else:
#
#   hl-read-secret <reference>
#
# The kit reads every secret through this (the keeper `hl-secrets`, a worker
# pane's `hl-env.sh`, the watchdog and `stage.sh`), unless program.json names
# a reader of its own in `secrets_reader`. The value goes to standard output
# and nowhere else: never to a file, a log or a command line. On a failure
# nothing is written to standard output, one line on standard error says why,
# and the exit status is 1. That line never holds the value, and for a
# reference it cannot place it does not repeat the reference either, in case
# a secret was passed where its reference belonged.
#
# References:
#
#   file:<path>       the file's content, less one trailing newline. `~/` at the
#                     start is the home directory. The file must belong to you
#                     and be open to nobody else (chmod 600). Works in every
#                     context: an SSH shell, a Herdr pane, a LaunchAgent.
#   op://<vault>/<item>/<field>
#                     1Password, through `op read`, with whatever sign-in `op`
#                     has (a service account's OP_SERVICE_ACCOUNT_TOKEN, or the
#                     desktop app).
#   keychain:<service>
#                     the macOS login keychain's generic password for that
#                     service (`security find-generic-password -w -s`). The
#                     login keychain is locked in an SSH shell, so this works in
#                     Herdr panes and LaunchAgents but not in `stage.sh` run
#                     over SSH.
#   env:<NAME>        the value of an environment variable. Not GH_TOKEN,
#                     GITHUB_TOKEN, CLAUDE_CODE_OAUTH_TOKEN or ANTHROPIC_API_KEY:
#                     hl-env.sh unsets those before it reads, so they would
#                     never be there.
#
# Every variable of this script's own starts `hlrs_`, so that one the caller
# happens to export under a plain name is never changed before `env:` reads it.

set -u
# No pathname expansion: `ls` output is split into words below, and a path may hold `*`.
set -f

hlrs_fail() {
  printf 'hl-read-secret: %s\n' "$1" >&2
  exit 1
}

# The first line a tool printed on standard error, or what to say when it printed none.
hlrs_first_line() {
  hlrs_line=$(sed -n '/[^[:space:]]/{p;q;}' "$1" 2>/dev/null)
  if [ -n "$hlrs_line" ]; then printf '%s' "$hlrs_line"; else printf '%s' "$2"; fi
}

hlrs_nl='
'

[ $# -eq 1 ] || hlrs_fail "usage: hl-read-secret <file:path | op://vault/item/field | keychain:service | env:NAME>"
hlrs_ref=$1
hlrs_errfile=""
trap '[ -n "$hlrs_errfile" ] && rm -f "$hlrs_errfile"' EXIT
trap 'exit 1' HUP INT TERM

# A place for a tool's standard error, which is never the value. Removed on exit.
hlrs_make_errfile() {
  hlrs_errfile=$(mktemp "${TMPDIR:-/tmp}/hl-read-secret.XXXXXX") || hlrs_fail "could not make a temporary file for the reader's messages"
}

case "$hlrs_ref" in
  file:*)
    hlrs_path=${hlrs_ref#file:}
    case "$hlrs_path" in
      "~/"*)
        [ -n "${HOME:-}" ] || hlrs_fail "file:~/ needs HOME, which is not set"
        hlrs_path="$HOME/${hlrs_path#\~/}"
        ;;
      "~"*) hlrs_fail "file: takes ~/ for the home directory, and no other ~ form" ;;
    esac
    [ -n "$hlrs_path" ] || hlrs_fail "file: names no path"
    [ -e "$hlrs_path" ] || hlrs_fail "$hlrs_path: no such file"
    [ -f "$hlrs_path" ] || hlrs_fail "$hlrs_path: not a regular file"
    [ -r "$hlrs_path" ] || hlrs_fail "$hlrs_path: not readable"
    # Owner and mode of the file that is read (a link is followed), from `ls -n`, which reads the same on macOS and Linux.
    # shellcheck disable=SC2046
    set -- $(ls -lnLd -- "$hlrs_path" 2>/dev/null)
    [ $# -ge 3 ] || hlrs_fail "$hlrs_path: its owner and mode could not be read"
    hlrs_mode=$1
    hlrs_owner=$3
    hlrs_me=$(id -u)
    [ "$hlrs_owner" = "$hlrs_me" ] || hlrs_fail "$hlrs_path: belongs to uid $hlrs_owner, not to you (uid $hlrs_me); a secret's file must be your own"
    # The permission characters after the type and the owner's three: group and others must have none.
    hlrs_rest=${hlrs_mode#?}
    hlrs_rest=${hlrs_rest#???}
    case "$hlrs_rest" in
      ------*) ;;
      *) hlrs_fail "$hlrs_path: group or others may use it (mode $hlrs_mode); run chmod 600 on it" ;;
    esac
    # Command substitution drops every trailing newline; the x keeps them, and exactly one is taken off.
    hlrs_value=$(cat -- "$hlrs_path" && printf x) || hlrs_fail "$hlrs_path: could not be read"
    hlrs_value=${hlrs_value%x}
    hlrs_value=${hlrs_value%"$hlrs_nl"}
    [ -n "$hlrs_value" ] || hlrs_fail "empty read: $hlrs_path holds nothing"
    ;;
  op://*)
    hlrs_make_errfile
    # `op` is found on the caller's PATH (a LaunchAgent's is the one install-watchdog.sh writes).
    hlrs_value=$(op read --no-newline -- "$hlrs_ref" 2>"$hlrs_errfile")
    hlrs_rc=$?
    [ "$hlrs_rc" -ne 127 ] || hlrs_fail "op, the 1Password CLI that reads op:// references, is not installed or not on PATH"
    [ "$hlrs_rc" -eq 0 ] || hlrs_fail "op read failed (exit $hlrs_rc): $(hlrs_first_line "$hlrs_errfile" "it said nothing")"
    [ -n "$hlrs_value" ] || hlrs_fail "empty read: op read gave nothing for $hlrs_ref"
    ;;
  keychain:*)
    hlrs_service=${hlrs_ref#keychain:}
    [ -n "$hlrs_service" ] || hlrs_fail "keychain: names no service"
    hlrs_make_errfile
    hlrs_value=$(security find-generic-password -w -s "$hlrs_service" 2>"$hlrs_errfile" && printf x)
    hlrs_rc=$?
    if [ "$hlrs_rc" -ne 0 ]; then
      hlrs_why="keychain item for service '$hlrs_service' could not be read (exit $hlrs_rc): $(hlrs_first_line "$hlrs_errfile" "security said nothing")"
      if [ -n "${SSH_CONNECTION:-}${SSH_TTY:-}" ]; then
        hlrs_why="$hlrs_why. This is an SSH shell, where the login keychain is locked: keychain: references work in a Herdr pane or a LaunchAgent, not over SSH (stage.sh over SSH needs a file: reference)"
      fi
      hlrs_fail "$hlrs_why"
    fi
    hlrs_value=${hlrs_value%x}
    hlrs_value=${hlrs_value%"$hlrs_nl"}
    [ -n "$hlrs_value" ] || hlrs_fail "empty read: the keychain item for service '$hlrs_service' holds nothing"
    ;;
  env:*)
    hlrs_name=${hlrs_ref#env:}
    case "$hlrs_name" in
      "" | [0-9]* | *[!A-Za-z0-9_]*) hlrs_fail "env: needs a variable's name (letters, digits and _, not starting with a digit)" ;;
      GH_TOKEN | GITHUB_TOKEN | CLAUDE_CODE_OAUTH_TOKEN | ANTHROPIC_API_KEY)
        hlrs_fail "env:$hlrs_name is refused: hl-env.sh unsets $hlrs_name before it reads a secret, so it is never there; keep the token in a variable of another name, or use another kind of reference"
        ;;
    esac
    # From the environment this process was given, never from a variable of this script's own.
    hlrs_value=$(printenv "$hlrs_name" && printf x) || hlrs_fail "env:$hlrs_name is not set"
    hlrs_value=${hlrs_value%x}
    hlrs_value=${hlrs_value%"$hlrs_nl"}
    [ -n "$hlrs_value" ] || hlrs_fail "empty read: env:$hlrs_name is set and empty"
    ;;
  *)
    # The reference is not repeated: what was passed may be a secret given where its reference belonged.
    hlrs_fail "unknown reference scheme: a reference starts with file:, op://, keychain: or env:"
    ;;
esac

printf '%s' "$hlrs_value"
