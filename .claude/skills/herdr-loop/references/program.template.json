{
  "program": "{{PROGRAM}}",
  "base": "main",
  "worker_claude_ref": "-",
  "claude_seats": [
    "~/.claude-seat-a",
    "~/.claude-seat-b"
  ],
  "seat_full_percent": 99,
  "gh_token_ref": "file:~/.config/herdr-loop/gh-token",
  "claude_model": "claude-sonnet-5-5",
  "claude_effort": "high",
  "build_effort": "high",
  "review_effort": "high",
  "rework_effort": "high",
  "efforts": [
    "medium",
    "high",
    "xhigh"
  ],
  "premise": "routed",
  "review": "code",
  "bounds": {
    "build": 3
  },
  "subagents": false,
  "secrets": "keeper",
  "briefs": "v2",
  "prepush": "touched",
  "review_with_ci": true,
  "cursor_model": "composer-2.5[fast=false]",
  "manager_model": "claude-opus-5-5",
  "manager_effort": "high",
  "manager_args": [
    "--tools",
    "Bash,Read,Edit,Write,Agent,TaskStop",
    "--disable-slash-commands",
    "--strict-mcp-config",
    "--mcp-config",
    "{{KIT}}/references/mcp-none.json"
  ],
  "handover_tokens": 200000,
  "ledger_archive_kb": 128,
  "outside_prs": "off",
  "manager_prompt": "MANAGER-PROMPT.md",
  "ntfy_url": null,
  "ntfy_user": null,
  "ntfy_password_ref": null
}
